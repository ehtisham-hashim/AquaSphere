// =========================================================================
// AQUASPHERE & WADAANA PRISMA SCHEMA
// =========================================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["aquasphere", "wadaana"]
}

// ==========================================
// AQUASPHERE SCHEMA
// ==========================================

model AquasphereCustomer {
  id                  String    @id @default(uuid())
  name                String
  phone               String    @unique
  address             String?
  mapLink             String?   @map("map_link")
  type                String
  deposit             Int       @default(0)
  defaultPrice        Decimal   @default(0.0) @map("default_price")
  creditLimit         Decimal   @default(0.0) @map("credit_limit")
  creditDuration      Int       @default(1) @map("credit_duration")
  remarks             String?
  homePictureUrl      String?   @map("home_picture_url")
  buys19L             Boolean   @default(false) @map("buys_19l")
  buys05LPet          Boolean   @default(false) @map("buys_05l_pet")
  buys15LPet          Boolean   @default(false) @map("buys_15l_pet")
  cachedBalance       Decimal   @default(0.0) @map("cached_balance")
  cachedBottleBalance Int       @default(0) @map("cached_bottle_balance")
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders             AquasphereOrder[]
  bottleTransactions AquasphereBottleTransaction[]
  payments           AquaspherePayment[]

  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@map("customers")
  @@schema("aquasphere")
}

model AquasphereItem {
  id           String    @id @default(uuid())
  name         String
  type         AquasphereItemType
  unit         String    @default("kg")
  cachedQty    Decimal   @default(0.0) @map("cached_qty")
  reorderLevel Decimal   @default(0.0) @map("reorder_level")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inventoryTransactions AquasphereInventoryTransaction[]
  orderItems            AquasphereOrderItem[]
  purchaseItems         AquaspherePurchaseItem[]
  batchConsumptions     AquasphereProductionBatchConsumption[]
  producedBatches       AquasphereProductionBatch[] @relation("ProducedItems")
  consumedBatches       AquasphereProductionBatch[] @relation("ConsumedItems")
  recipeFinishedGoods   AquasphereRecipeItem[] @relation("RecipeFinishedGood")
  recipeRawMaterials    AquasphereRecipeItem[] @relation("RecipeRawMaterial")

  @@map("items")
  @@schema("aquasphere")
}

enum AquasphereItemType {
  RAW_MATERIAL
  FINISHED_GOOD

  @@map("item_types")
  @@schema("aquasphere")
}

model AquasphereInventoryTransaction {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  item      AquasphereItem @relation(fields: [itemId], references: [id])
  quantity  Decimal
  direction AquasphereTransactionDirection
  reason    String
  refType   String?        @map("ref_type")
  refId     String?        @map("ref_id")
  location  String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_transactions")
  @@schema("aquasphere")
}

model AquasphereBottleTransaction {
  id         String                      @id @default(uuid())
  customerId String?                     @map("customer_id")
  customer   AquasphereCustomer?         @relation(fields: [customerId], references: [id])
  type       AquasphereBottleTransactionType @map("txn_type")
  quantity   Int
  reason     String?
  createdAt  DateTime                    @default(now()) @map("created_at")

  @@index([customerId, type, createdAt])
  @@map("bottle_transactions")
  @@schema("aquasphere")
}

enum AquasphereBottleTransactionType {
  NEW_PURCHASE
  DELIVERED_TO_CUSTOMER
  RETURNED_GOOD
  RETURNED_BROKEN
  MARKED_LOST
  AT_FACTORY_ADJUSTMENT

  @@map("bottle_transaction_types")
  @@schema("aquasphere")
}

model AquasphereOrder {
  id               String               @id @default(uuid())
  customerId       String               @map("customer_id")
  customer         AquasphereCustomer   @relation(fields: [customerId], references: [id])
  type             AquasphereOrderType
  deliveryStatus   AquasphereDeliveryStatus       @default(PENDING) @map("delivery_status")
  paymentStatus    AquaspherePaymentStatus        @default(UNPAID) @map("payment_status")
  expectedDelivery DateTime?            @map("expected_delivery")
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  items            AquasphereOrderItem[]
  deliveries       AquasphereDelivery[]
  payments         AquaspherePayment[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([deliveryStatus, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
  @@schema("aquasphere")
}

enum AquasphereOrderType {
  NINETEEN_L
  PET

  @@map("order_types")
  @@schema("aquasphere")
}

model AquasphereOrderItem {
  id       String         @id @default(uuid())
  orderId  String         @map("order_id")
  order    AquasphereOrder @relation(fields: [orderId], references: [id])
  itemId   String         @map("item_id")
  item     AquasphereItem  @relation(fields: [itemId], references: [id])
  quantity Int
  price    Decimal

  @@map("order_items")
  @@schema("aquasphere")
}

model AquasphereDelivery {
  id                    String         @id @default(uuid())
  orderId               String         @map("order_id")
  order                 AquasphereOrder @relation(fields: [orderId], references: [id])
  qtyDelivered          Int            @map("qty_delivered")
  bottlesReturnedGood   Int            @default(0) @map("bottles_returned_good")
  bottlesReturnedBroken Int            @default(0) @map("bottles_returned_broken")
  cashReceived          Decimal        @default(0.0) @map("cash_received")
  paymentMethod         String?        @map("payment_method")
  remarks               String?
  deliveredAt           DateTime       @default(now()) @map("delivered_at")

  @@index([orderId, deliveredAt])
  @@map("deliveries")
  @@schema("aquasphere")
}

model AquaspherePayment {
  id         String             @id @default(uuid())
  orderId    String?            @map("order_id")
  order      AquasphereOrder?   @relation(fields: [orderId], references: [id])
  customerId String             @map("customer_id")
  customer   AquasphereCustomer @relation(fields: [customerId], references: [id])
  amount     Decimal
  type       AquaspherePaymentType
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([customerId, createdAt(sort: Desc)])
  @@map("payments")
  @@schema("aquasphere")
}

model AquasphereProductionBatch {
  id                  String   @id @default(uuid())
  outputItemId        String?  @map("output_item_id")
  outputItem          AquasphereItem? @relation("ProducedItems", fields: [outputItemId], references: [id])
  inputItemId         String?  @map("input_item_id")
  inputItem           AquasphereItem? @relation("ConsumedItems", fields: [inputItemId], references: [id])
  location            AquasphereLocation?
  quantity            Int?
  wasteQuantity       Int      @default(0) @map("waste_quantity")
  remarks             String?
  packs05L            Int      @default(0) @map("packs_05l")      // 0.5L packs produced (good output)
  packs15L            Int      @default(0) @map("packs_15l")      // 1.5L packs produced (good output)
  brokenBottles05L    Int      @default(0) @map("broken_bottles_05l")
  brokenBottles15L    Int      @default(0) @map("broken_bottles_15l")
  batchDate           DateTime @default(now()) @map("batch_date")
  producedBy          String?  @map("produced_by")                // req.user.id
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  consumptions AquasphereProductionBatchConsumption[]

  @@index([batchDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("production_batches")
  @@schema("aquasphere")
}

model AquasphereProductionBatchConsumption {
  id           String                    @id @default(uuid())
  batchId      String                    @map("batch_id")
  batch        AquasphereProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId       String                    @map("item_id")
  item         AquasphereItem            @relation(fields: [itemId], references: [id])
  quantityUsed Decimal                   @map("quantity_used")  // exact, never rounded
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@index([batchId])
  @@map("production_batch_consumptions")
  @@schema("aquasphere")
}

model AquasphereVendor {
  id         String    @id @default(uuid())
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  purchases     AquaspherePurchase[]
  payments      AquasphereVendorPayment[]
  ledgerEntries AquasphereVendorLedgerEntry[]

  @@map("vendors")
  @@schema("aquasphere")
}

model AquaspherePurchase {
  id           String    @id @default(uuid())
  vendorId     String    @map("vendor_id")
  vendor       AquasphereVendor @relation(fields: [vendorId], references: [id])
  invoiceNo    String?   @map("invoice_no")
  receiptUrl   String?   @map("receipt_url")
  remarks      String?
  grandTotal   Decimal   @default(0.0) @map("grand_total")
  purchaseDate DateTime  @default(now()) @map("purchase_date")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  items         AquaspherePurchaseItem[]
  ledgerEntries AquasphereVendorLedgerEntry[]

  @@index([vendorId, createdAt])
  @@map("purchases")
  @@schema("aquasphere")
}

model AquaspherePurchaseItem {
  id         String         @id @default(uuid())
  purchaseId String         @map("purchase_id")
  purchase   AquaspherePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String         @map("item_id")
  item       AquasphereItem   @relation(fields: [itemId], references: [id])
  quantity   Decimal
  unitPrice  Decimal        @map("unit_price")
  total      Decimal
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("purchase_items")
  @@schema("aquasphere")
}

enum AquasphereVendorLedgerType {
  PURCHASE
  PAYMENT

  @@map("vendor_ledger_types")
  @@schema("aquasphere")
}

model AquasphereVendorLedgerEntry {
  id         String                 @id @default(uuid())
  vendorId   String                 @map("vendor_id")
  vendor     AquasphereVendor       @relation(fields: [vendorId], references: [id])
  purchaseId String?                @map("purchase_id")
  purchase   AquaspherePurchase?    @relation(fields: [purchaseId], references: [id])
  type       AquasphereVendorLedgerType
  amount     Decimal
  remarks    String?
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_ledger_entries")
  @@schema("aquasphere")
}

model AquasphereAuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  details     String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("aquasphere")
}

model AquasphereVendorPayment {
  id        String         @id @default(uuid())
  vendorId  String         @map("vendor_id")
  vendor    AquasphereVendor @relation(fields: [vendorId], references: [id])
  amount    Decimal
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_payments")
  @@schema("aquasphere")
}

model AquasphereExpense {
  id         String   @id @default(uuid())
  category   String
  amount     Decimal
  receiptUrl String   @map("receipt_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt, category])
  @@map("expenses")
  @@schema("aquasphere")
}

model AquasphereDailyClose {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  closedAt   DateTime @default(now()) @map("closed_at")
  closedById String   @map("closed_by_id")
  closedBy   AquasphereUser @relation(fields: [closedById], references: [id])

  @@map("daily_closes")
  @@schema("aquasphere")
}


model AquasphereUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         AquasphereRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  dailyCloses  AquasphereDailyClose[]

  @@map("users")
  @@schema("aquasphere")
}

enum AquasphereRole {
  OWNER
  ADMIN
  PRODUCTION_MANAGER
  ACCOUNTANT
  MARKETING_MANAGER

  @@map("roles")
  @@schema("aquasphere")
}

enum AquasphereTransactionDirection {
  IN
  OUT

  @@map("transaction_directions")
  @@schema("aquasphere")
}

enum AquasphereDeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED

  @@map("delivery_statuses")
  @@schema("aquasphere")
}

enum AquaspherePaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("payment_statuses")
  @@schema("aquasphere")
}

enum AquaspherePaymentType {
  CASH
  BANK_TRANSFER
  CHEQUE

  @@map("payment_types")
  @@schema("aquasphere")
}

enum AquasphereLocation {
  FACTORY
  WAREHOUSE

  @@map("locations")
  @@schema("aquasphere")
}

model AquasphereRecipeItem {
  id               String         @id @default(uuid())
  finishedGoodId   String         @map("finished_good_id")
  rawMaterialId    String         @map("raw_material_id")
  quantityPerUnit  Decimal        @map("quantity_per_unit")
  
  finishedGood     AquasphereItem @relation("RecipeFinishedGood", fields: [finishedGoodId], references: [id])
  rawMaterial      AquasphereItem @relation("RecipeRawMaterial", fields: [rawMaterialId], references: [id])

  @@unique([finishedGoodId, rawMaterialId])
  @@map("recipe_items")
  @@schema("aquasphere")
}

model AquasphereSpotSale {
  id             String   @id @default(uuid())
  litresSold     Decimal  @map("litres_sold")
  capsIssued     Int      @default(0) @map("caps_issued")
  cashCollected  Decimal  @default(0.0) @map("cash_collected")
  paymentMethod  String   @default("CASH") @map("payment_method")
  remarks        String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("spot_sales")
  @@schema("aquasphere")
}


// ==========================================
// WADAANA SCHEMA
// ==========================================

model WadaanaCustomer {
  id                  String    @id @default(uuid())
  name                String
  phone               String    @unique
  address             String?
  mapLink             String?   @map("map_link")
  type                String
  deposit             Int       @default(0)
  defaultPrice        Decimal   @default(0.0) @map("default_price")
  creditLimit         Decimal   @default(0.0) @map("credit_limit")
  creditDuration      Int       @default(1) @map("credit_duration")
  remarks             String?
  homePictureUrl      String?   @map("home_picture_url")
  buysPure05L         Boolean   @default(false) @map("buys_pure_05l")
  buysPure15L         Boolean   @default(false) @map("buys_pure_15l")
  buysMix05L          Boolean   @default(false) @map("buys_mix_05l")
  buysMix15L          Boolean   @default(false) @map("buys_mix_15l")
  cachedBalance       Decimal   @default(0.0) @map("cached_balance")
  cachedBottleBalance Int       @default(0) @map("cached_bottle_balance")
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders             WadaanaOrder[]
  bottleTransactions WadaanaBottleTransaction[]
  payments           WadaanaPayment[]

  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@map("customers")
  @@schema("wadaana")
}

model WadaanaItem {
  id           String    @id @default(uuid())
  name         String
  type         WadaanaItemType
  unit         String    @default("kg")
  cachedQty    Decimal   @default(0.0) @map("cached_qty")
  reorderLevel Decimal   @default(0.0) @map("reorder_level")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inventoryTransactions WadaanaInventoryTransaction[]
  orderItems            WadaanaOrderItem[]
  purchaseItems         WadaanaPurchaseItem[]
  batchConsumptions     WadaanaProductionBatchConsumption[]
  producedBatches       WadaanaProductionBatch[] @relation("ProducedItems")
  consumedBatches       WadaanaProductionBatch[] @relation("ConsumedItems")
  recipeFinishedGoods   WadaanaRecipeItem[] @relation("RecipeFinishedGood")
  recipeRawMaterials    WadaanaRecipeItem[] @relation("RecipeRawMaterial")

  @@map("items")
  @@schema("wadaana")
}

enum WadaanaItemType {
  RAW_MATERIAL
  FINISHED_GOOD

  @@map("item_types")
  @@schema("wadaana")
}

model WadaanaInventoryTransaction {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  item      WadaanaItem @relation(fields: [itemId], references: [id])
  quantity  Decimal
  direction WadaanaTransactionDirection
  reason    String
  refType   String?        @map("ref_type")
  refId     String?        @map("ref_id")
  location  String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_transactions")
  @@schema("wadaana")
}

model WadaanaBottleTransaction {
  id         String                      @id @default(uuid())
  customerId String?                     @map("customer_id")
  customer   WadaanaCustomer?         @relation(fields: [customerId], references: [id])
  type       WadaanaBottleTransactionType @map("txn_type")
  quantity   Int
  reason     String?
  createdAt  DateTime                    @default(now()) @map("created_at")

  @@index([customerId, type, createdAt])
  @@map("bottle_transactions")
  @@schema("wadaana")
}

enum WadaanaBottleTransactionType {
  NEW_PURCHASE
  DELIVERED_TO_CUSTOMER
  RETURNED_GOOD
  RETURNED_BROKEN
  MARKED_LOST
  AT_FACTORY_ADJUSTMENT

  @@map("bottle_transaction_types")
  @@schema("wadaana")
}

model WadaanaOrder {
  id               String               @id @default(uuid())
  customerId       String               @map("customer_id")
  customer         WadaanaCustomer   @relation(fields: [customerId], references: [id])
  type             WadaanaOrderType
  deliveryStatus   WadaanaDeliveryStatus       @default(PENDING) @map("delivery_status")
  paymentStatus    WadaanaPaymentStatus        @default(UNPAID) @map("payment_status")
  expectedDelivery DateTime?            @map("expected_delivery")
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  items            WadaanaOrderItem[]
  deliveries       WadaanaDelivery[]
  payments         WadaanaPayment[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([deliveryStatus, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
  @@schema("wadaana")
}

enum WadaanaOrderType {
  PURE_BOTTLES
  MIX_BOTTLES

  @@map("order_types")
  @@schema("wadaana")
}

model WadaanaOrderItem {
  id       String         @id @default(uuid())
  orderId  String         @map("order_id")
  order    WadaanaOrder @relation(fields: [orderId], references: [id])
  itemId   String         @map("item_id")
  item     WadaanaItem  @relation(fields: [itemId], references: [id])
  quantity Int
  price    Decimal

  @@map("order_items")
  @@schema("wadaana")
}

model WadaanaDelivery {
  id                    String         @id @default(uuid())
  orderId               String         @map("order_id")
  order                 WadaanaOrder @relation(fields: [orderId], references: [id])
  qtyDelivered          Int            @map("qty_delivered")
  bottlesReturnedGood   Int            @default(0) @map("bottles_returned_good")
  bottlesReturnedBroken Int            @default(0) @map("bottles_returned_broken")
  cashReceived          Decimal        @default(0.0) @map("cash_received")
  paymentMethod         String?        @map("payment_method")
  remarks               String?
  deliveredAt           DateTime       @default(now()) @map("delivered_at")

  @@index([orderId, deliveredAt])
  @@map("deliveries")
  @@schema("wadaana")
}

model WadaanaPayment {
  id         String             @id @default(uuid())
  orderId    String?            @map("order_id")
  order      WadaanaOrder?   @relation(fields: [orderId], references: [id])
  customerId String             @map("customer_id")
  customer   WadaanaCustomer @relation(fields: [customerId], references: [id])
  amount     Decimal
  type       WadaanaPaymentType
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([customerId, createdAt(sort: Desc)])
  @@map("payments")
  @@schema("wadaana")
}

model WadaanaProductionBatch {
  id                  String   @id @default(uuid())
  outputItemId        String?  @map("output_item_id")
  outputItem          WadaanaItem? @relation("ProducedItems", fields: [outputItemId], references: [id])
  inputItemId         String?  @map("input_item_id")
  inputItem           WadaanaItem? @relation("ConsumedItems", fields: [inputItemId], references: [id])
  location            WadaanaLocation?
  quantity            Int?
  wasteQuantity       Int      @default(0) @map("waste_quantity")
  remarks             String?
  packs05L            Int      @default(0) @map("packs_05l")      // 0.5L packs produced (good output)
  packs15L            Int      @default(0) @map("packs_15l")      // 1.5L packs produced (good output)
  brokenBottles05L    Int      @default(0) @map("broken_bottles_05l")
  brokenBottles15L    Int      @default(0) @map("broken_bottles_15l")
  batchDate           DateTime @default(now()) @map("batch_date")
  producedBy          String?  @map("produced_by")                // req.user.id
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  consumptions WadaanaProductionBatchConsumption[]

  @@index([batchDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("production_batches")
  @@schema("wadaana")
}

model WadaanaProductionBatchConsumption {
  id           String                    @id @default(uuid())
  batchId      String                    @map("batch_id")
  batch        WadaanaProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId       String                    @map("item_id")
  item         WadaanaItem            @relation(fields: [itemId], references: [id])
  quantityUsed Decimal                   @map("quantity_used")  // exact, never rounded
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@index([batchId])
  @@map("production_batch_consumptions")
  @@schema("wadaana")
}

model WadaanaVendor {
  id         String    @id @default(uuid())
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  purchases     WadaanaPurchase[]
  payments      WadaanaVendorPayment[]
  ledgerEntries WadaanaVendorLedgerEntry[]

  @@map("vendors")
  @@schema("wadaana")
}

model WadaanaPurchase {
  id           String    @id @default(uuid())
  vendorId     String    @map("vendor_id")
  vendor       WadaanaVendor @relation(fields: [vendorId], references: [id])
  invoiceNo    String?   @map("invoice_no")
  receiptUrl   String?   @map("receipt_url")
  remarks      String?
  grandTotal   Decimal   @default(0.0) @map("grand_total")
  purchaseDate DateTime  @default(now()) @map("purchase_date")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  items         WadaanaPurchaseItem[]
  ledgerEntries WadaanaVendorLedgerEntry[]

  @@index([vendorId, createdAt])
  @@map("purchases")
  @@schema("wadaana")
}

model WadaanaPurchaseItem {
  id         String         @id @default(uuid())
  purchaseId String         @map("purchase_id")
  purchase   WadaanaPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String         @map("item_id")
  item       WadaanaItem   @relation(fields: [itemId], references: [id])
  quantity   Decimal
  unitPrice  Decimal        @map("unit_price")
  total      Decimal
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("purchase_items")
  @@schema("wadaana")
}

enum WadaanaVendorLedgerType {
  PURCHASE
  PAYMENT

  @@map("vendor_ledger_types")
  @@schema("wadaana")
}

model WadaanaVendorLedgerEntry {
  id         String                 @id @default(uuid())
  vendorId   String                 @map("vendor_id")
  vendor     WadaanaVendor       @relation(fields: [vendorId], references: [id])
  purchaseId String?                @map("purchase_id")
  purchase   WadaanaPurchase?    @relation(fields: [purchaseId], references: [id])
  type       WadaanaVendorLedgerType
  amount     Decimal
  remarks    String?
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_ledger_entries")
  @@schema("wadaana")
}

model WadaanaAuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  details     String?
  performedBy String?  @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("wadaana")
}

model WadaanaVendorPayment {
  id        String         @id @default(uuid())
  vendorId  String         @map("vendor_id")
  vendor    WadaanaVendor @relation(fields: [vendorId], references: [id])
  amount    Decimal
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_payments")
  @@schema("wadaana")
}

model WadaanaExpense {
  id         String   @id @default(uuid())
  category   String
  amount     Decimal
  receiptUrl String   @map("receipt_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt, category])
  @@map("expenses")
  @@schema("wadaana")
}

model WadaanaDailyClose {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  closedAt   DateTime @default(now()) @map("closed_at")
  closedById String   @map("closed_by_id")
  closedBy   WadaanaUser @relation(fields: [closedById], references: [id])

  @@map("daily_closes")
  @@schema("wadaana")
}


model WadaanaUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         WadaanaRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  dailyCloses  WadaanaDailyClose[]

  @@map("users")
  @@schema("wadaana")
}

enum WadaanaRole {
  OWNER
  ADMIN
  PRODUCTION_MANAGER
  ACCOUNTANT
  MARKETING_MANAGER

  @@map("roles")
  @@schema("wadaana")
}

enum WadaanaTransactionDirection {
  IN
  OUT

  @@map("transaction_directions")
  @@schema("wadaana")
}

enum WadaanaDeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED

  @@map("delivery_statuses")
  @@schema("wadaana")
}

enum WadaanaPaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("payment_statuses")
  @@schema("wadaana")
}

enum WadaanaPaymentType {
  CASH
  BANK_TRANSFER
  CHEQUE

  @@map("payment_types")
  @@schema("wadaana")
}

enum WadaanaLocation {
  FACTORY
  WAREHOUSE

  @@map("locations")
  @@schema("wadaana")
}

model WadaanaRecipeItem {
  id               String         @id @default(uuid())
  finishedGoodId   String         @map("finished_good_id")
  rawMaterialId    String         @map("raw_material_id")
  quantityPerUnit  Decimal        @map("quantity_per_unit")
  
  finishedGood     WadaanaItem @relation("RecipeFinishedGood", fields: [finishedGoodId], references: [id])
  rawMaterial      WadaanaItem @relation("RecipeRawMaterial", fields: [rawMaterialId], references: [id])

  @@unique([finishedGoodId, rawMaterialId])
  @@map("recipe_items")
  @@schema("wadaana")
}

model WadaanaSpotSale {
  id             String   @id @default(uuid())
  litresSold     Decimal  @map("litres_sold")
  capsIssued     Int      @default(0) @map("caps_issued")
  cashCollected  Decimal  @default(0.0) @map("cash_collected")
  paymentMethod  String   @default("CASH") @map("payment_method")
  remarks        String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("spot_sales")
  @@schema("wadaana")
}
