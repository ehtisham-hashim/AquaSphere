model WadaanaCompany {
  id                  String    @id @default(uuid())
  name                String
  phone               String?
  address             String?
  creditLimit         Decimal   @default(0.0) @map("credit_limit")
  creditDuration      Int       @default(1) @map("credit_duration")
  cachedBalance       Decimal   @default(0.0) @map("cached_balance")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders             WadaanaOrder[]
  payments           WadaanaPayment[]
  productionBatches  WadaanaProductionBatch[]
  notifications      WadaanaNotification[]

  @@index([name])
  @@map("companies")
  @@schema("wadaana")
}

model WadaanaItem {
  id           String    @id @default(uuid())
  name         String
  type         WadaanaItemType
  preformType  WadaanaPreformType? @map("preform_type")
  preformWeightGrams Decimal?     @map("preform_weight_grams")
  cachedQty    Decimal   @default(0.0) @map("cached_qty")
  reorderLevel Decimal   @default(0.0) @map("reorder_level")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inventoryTransactions WadaanaInventoryTransaction[]
  orderItems            WadaanaOrderItem[]
  purchases             WadaanaPurchase[]
  producedBatches       WadaanaProductionBatch[] @relation("ProducedItems")
  consumedBatches       WadaanaProductionBatch[] @relation("ConsumedItems")

  @@map("items")
  @@schema("wadaana")
}

enum WadaanaItemType {
  RAW_MATERIAL
  FINISHED_GOOD

  @@map("item_types")
  @@schema("wadaana")
}

enum WadaanaPreformType {
  PURE
  MIX

  @@map("preform_types")
  @@schema("wadaana")
}

enum WadaanaLocation {
  FACTORY
  WAREHOUSE

  @@map("locations")
  @@schema("wadaana")
}

enum WadaanaBottleSize {
  HALF_LITER     
  ONE_POINT_FIVE 
  NINETEEN_LITER 

  @@map("bottle_sizes")
  @@schema("wadaana")
}

model WadaanaInventoryTransaction {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  item      WadaanaItem     @relation(fields: [itemId], references: [id])
  quantity  Decimal
  direction String
  reason    String
  refType   String?        @map("ref_type")
  refId     String?        @map("ref_id")
  location  WadaanaLocation?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_transactions")
  @@schema("wadaana")
}

model WadaanaProductionBatch {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  company             WadaanaCompany @relation(fields: [companyId], references: [id])
  bottleSize          WadaanaBottleSize? @map("bottle_size")
  preformType         WadaanaPreformType @map("preform_type")
  
  outputItemId        String?  @map("output_item_id")
  outputItem          WadaanaItem? @relation("ProducedItems", fields: [outputItemId], references: [id])
  
  inputItemId         String?  @map("input_item_id")
  inputItem           WadaanaItem? @relation("ConsumedItems", fields: [inputItemId], references: [id])
  
  preformConsumedKg   Decimal? @map("preform_consumed_kg")
  location            WadaanaLocation
  quantity            Int?
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("production_batches")
  @@schema("wadaana")
}

model WadaanaOrder {
  id               String               @id @default(uuid())
  companyId        String               @map("company_id")
  company          WadaanaCompany        @relation(fields: [companyId], references: [id])
  deliveryStatus   String               @default("pending") @map("delivery_status")
  paymentStatus    String               @default("unpaid") @map("payment_status")
  expectedDelivery DateTime?            @map("expected_delivery")
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  items            WadaanaOrderItem[]
  payments         WadaanaPayment[]
  deliveries       WadaanaDelivery[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([deliveryStatus, createdAt])
  @@map("orders")
  @@schema("wadaana")
}

model WadaanaOrderItem {
  id       String         @id @default(uuid())
  orderId  String         @map("order_id")
  order    WadaanaOrder    @relation(fields: [orderId], references: [id])
  itemId   String         @map("item_id")
  item     WadaanaItem     @relation(fields: [itemId], references: [id])
  quantity Int
  price    Decimal

  @@map("order_items")
  @@schema("wadaana")
}

model WadaanaDelivery {
  id                    String         @id @default(uuid())
  orderId               String         @map("order_id")
  order                 WadaanaOrder    @relation(fields: [orderId], references: [id])
  qtyDelivered          Int            @map("qty_delivered")
  remarks               String?
  deliveredAt           DateTime       @default(now()) @map("delivered_at")

  @@index([orderId, deliveredAt])
  @@map("deliveries")
  @@schema("wadaana")
}

model WadaanaPayment {
  id         String             @id @default(uuid())
  orderId    String?            @map("order_id")
  order      WadaanaOrder?       @relation(fields: [orderId], references: [id])
  companyId  String             @map("company_id")
  company    WadaanaCompany      @relation(fields: [companyId], references: [id])
  amount     Decimal
  type       String
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([companyId, createdAt(sort: Desc)])
  @@map("payments")
  @@schema("wadaana")
}

model WadaanaVendor {
  id         String    @id @default(uuid())
  name       String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  purchases WadaanaPurchase[]
  payments  WadaanaVendorPayment[]

  @@map("vendors")
  @@schema("wadaana")
}

model WadaanaPurchase {
  id         String         @id @default(uuid())
  vendorId   String         @map("vendor_id")
  vendor     WadaanaVendor   @relation(fields: [vendorId], references: [id])
  itemId     String         @map("item_id")
  item       WadaanaItem     @relation(fields: [itemId], references: [id])
  quantity   Decimal
  price      Decimal
  receiptUrl String         @map("receipt_url")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("purchases")
  @@schema("wadaana")
}

model WadaanaVendorPayment {
  id        String         @id @default(uuid())
  vendorId  String         @map("vendor_id")
  vendor    WadaanaVendor   @relation(fields: [vendorId], references: [id])
  amount    Decimal
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_payments")
  @@schema("wadaana")
}

model WadaanaExpense {
  id         String   @id @default(uuid())
  category   String
  amount     Decimal
  receiptUrl String   @map("receipt_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt, category])
  @@map("expenses")
  @@schema("wadaana")
}

model WadaanaDailyClose {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  closedAt   DateTime @default(now()) @map("closed_at")
  closedById String   @map("closed_by_id")

  @@map("daily_closes")
  @@schema("wadaana")
}

model WadaanaNotification {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  company    WadaanaCompany? @relation(fields: [companyId], references: [id])
  type       String   
  channel    String?
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
  @@schema("wadaana")
}

model WadaanaUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         WadaanaRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
  @@schema("wadaana")
}

enum WadaanaRole {
  OWNER
  ADMIN
  PRODUCTION_MANAGER
  ACCOUNTANT
  MARKETING_MANAGER

  @@map("roles")
  @@schema("wadaana")
}
