model AquasphereCustomer {
  id                  String    @id @default(uuid())
  customerId          String    @unique @default(uuid()) @map("customer_id")
  name                String
  phone               String
  address             String?
  mapLink             String?   @map("map_link")
  type                String
  deposit             Int       @default(0)
  defaultPrice        Decimal   @default(0.0) @map("default_price")
  creditLimit         Decimal   @default(0.0) @map("credit_limit")
  creditDuration      Int       @default(1) @map("credit_duration")
  remarks             String?
  homePictureUrl      String?   @map("home_picture_url")
  cachedBalance       Decimal   @default(0.0) @map("cached_balance")
  cachedBottleBalance Int       @default(0) @map("cached_bottle_balance")
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders             AquasphereOrder[]
  bottleTransactions AquasphereBottleTransaction[]
  payments           AquaspherePayment[]

  @@unique([phone])
  @@index([name])
  @@map("customers")
  @@schema("aquasphere")
}

model AquasphereItem {
  id           String    @id @default(uuid())
  name         String
  type         AquasphereItemType
  cachedQty    Decimal   @default(0.0) @map("cached_qty")
  reorderLevel Decimal   @default(0.0) @map("reorder_level")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  inventoryTransactions AquasphereInventoryTransaction[]
  orderItems            AquasphereOrderItem[]
  purchases             AquaspherePurchase[]

  @@map("items")
  @@schema("aquasphere")
}

enum AquasphereItemType {
  RAW_MATERIAL
  FINISHED_GOOD

  @@map("item_types")
  @@schema("aquasphere")
}

model AquasphereInventoryTransaction {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  item      AquasphereItem @relation(fields: [itemId], references: [id])
  quantity  Decimal
  direction String
  reason    String
  refType   String?        @map("ref_type")
  refId     String?        @map("ref_id")
  location  String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_transactions")
  @@schema("aquasphere")
}

model AquasphereBottleTransaction {
  id         String                      @id @default(uuid())
  customerId String?                     @map("customer_id")
  customer   AquasphereCustomer?         @relation(fields: [customerId], references: [id])
  type       AquasphereBottleTransactionType @map("txn_type")
  quantity   Int
  reason     String?
  createdAt  DateTime                    @default(now()) @map("created_at")

  @@index([customerId, type, createdAt])
  @@map("bottle_transactions")
  @@schema("aquasphere")
}

enum AquasphereBottleTransactionType {
  NEW_PURCHASE
  DELIVERED_TO_CUSTOMER
  RETURNED_GOOD
  RETURNED_BROKEN
  MARKED_LOST
  AT_FACTORY_ADJUSTMENT

  @@map("bottle_transaction_types")
  @@schema("aquasphere")
}

model AquasphereOrder {
  id               String               @id @default(uuid())
  customerId       String               @map("customer_id")
  customer         AquasphereCustomer   @relation(fields: [customerId], references: [id])
  type             AquasphereOrderType
  deliveryStatus   String               @default("pending") @map("delivery_status")
  paymentStatus    String               @default("unpaid") @map("payment_status")
  expectedDelivery DateTime?            @map("expected_delivery")
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  items            AquasphereOrderItem[]
  deliveries       AquasphereDelivery[]
  payments         AquaspherePayment[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([deliveryStatus, createdAt])
  @@map("orders")
  @@schema("aquasphere")
}

enum AquasphereOrderType {
  NINETEEN_L
  PET

  @@map("order_types")
  @@schema("aquasphere")
}

model AquasphereOrderItem {
  id       String         @id @default(uuid())
  orderId  String         @map("order_id")
  order    AquasphereOrder @relation(fields: [orderId], references: [id])
  itemId   String         @map("item_id")
  item     AquasphereItem  @relation(fields: [itemId], references: [id])
  quantity Int
  price    Decimal

  @@map("order_items")
  @@schema("aquasphere")
}

model AquasphereDelivery {
  id                    String         @id @default(uuid())
  orderId               String         @map("order_id")
  order                 AquasphereOrder @relation(fields: [orderId], references: [id])
  qtyDelivered          Int            @map("qty_delivered")
  bottlesReturnedGood   Int            @default(0) @map("bottles_returned_good")
  bottlesReturnedBroken Int            @default(0) @map("bottles_returned_broken")
  cashReceived          Decimal        @default(0.0) @map("cash_received")
  paymentMethod         String?        @map("payment_method")
  remarks               String?
  deliveredAt           DateTime       @default(now()) @map("delivered_at")

  @@index([orderId, deliveredAt])
  @@map("deliveries")
  @@schema("aquasphere")
}

model AquaspherePayment {
  id         String             @id @default(uuid())
  orderId    String?            @map("order_id")
  order      AquasphereOrder?   @relation(fields: [orderId], references: [id])
  customerId String             @map("customer_id")
  customer   AquasphereCustomer @relation(fields: [customerId], references: [id])
  amount     Decimal
  type       String
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([customerId, createdAt(sort: Desc)])
  @@map("payments")
  @@schema("aquasphere")
}

model AquasphereProductionBatch {
  id                  String   @id @default(uuid())
  qty05LProduced      Int?     @map("qty_05l_produced")
  qty15LProduced      Int?     @map("qty_15l_produced")
  mineralSetsConsumed Decimal? @map("mineral_sets_consumed")
  bottleSize          String?  @map("bottle_size")
  preformType         String?  @map("preform_type")
  location            String?
  quantity            Int?
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("production_batches")
  @@schema("aquasphere")
}

model AquasphereVendor {
  id         String    @id @default(uuid())
  name       String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  purchases AquaspherePurchase[]
  payments  AquasphereVendorPayment[]

  @@map("vendors")
  @@schema("aquasphere")
}

model AquaspherePurchase {
  id         String         @id @default(uuid())
  vendorId   String         @map("vendor_id")
  vendor     AquasphereVendor @relation(fields: [vendorId], references: [id])
  itemId     String         @map("item_id")
  item       AquasphereItem   @relation(fields: [itemId], references: [id])
  quantity   Decimal
  price      Decimal
  receiptUrl String         @map("receipt_url")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("purchases")
  @@schema("aquasphere")
}

model AquasphereVendorPayment {
  id        String         @id @default(uuid())
  vendorId  String         @map("vendor_id")
  vendor    AquasphereVendor @relation(fields: [vendorId], references: [id])
  amount    Decimal
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([vendorId, createdAt])
  @@map("vendor_payments")
  @@schema("aquasphere")
}

model AquasphereExpense {
  id         String   @id @default(uuid())
  category   String
  amount     Decimal
  receiptUrl String   @map("receipt_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt, category])
  @@map("expenses")
  @@schema("aquasphere")
}

model AquasphereDailyClose {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  closedAt   DateTime @default(now()) @map("closed_at")
  closedById String   @map("closed_by_id")

  @@map("daily_closes")
  @@schema("aquasphere")
}

model AquasphereNotification {
  id         String   @id @default(uuid())
  type       String   
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("notifications")
  @@schema("aquasphere")
}
